data:match_material_Sandstone a rdf:Statement ;
    amt:weight 0.95 ;
    ogham:matchConfidence 0.95 ;
    ogham:matchStatus "auto" ;
    ogham:matchTypeCheck "ok" ;
    rdf:object wd:Q13085 ;
    rdf:predicate skos:closeMatch ;
    rdf:subject data:material_Sandstone .

data:stone_S_MOR_001 a ogham:OghamStone,
        crm:E22_Human-Made_Object ;
    rdfs:label "Dyke (S-MOR-001)" ;
    ogham:appCount 1 ;
    ogham:carries data:inscription_S_MOR_001 ;
    ogham:choiceCount 3 ;
    ogham:gapCount 9 ;
    ogham:rdgCount 0 ;
    ogham:recordStatus "numbered" ;
    ogham:shows data:person_S_MOR_001_EDDRRNON ;
    ogham:suppliedCount 0 ;
    ogham:unclearCount 12 ;
    crm:P1_is_identified_by data:id_S_MOR_001_CISP,
        data:id_S_MOR_001_Trove ;
    crm:P2_has_type data:type_Cross_slab ;
    crm:P45_consists_of data:material_Sandstone ;
    crm:P53_has_former_or_current_location data:place_S_MOR_001 ;
    crm:P56_bears_feature data:surface_S_MOR_001 .

data:agent_OGHAM_LH a prov:Agent ;
    rdfs:label "OG(H)AM edition (LH)" .

data:id_S_MOR_001_CISP a crm:E42_Identifier ;
