    crm:P2_has_type "SMR" .

data:id_I_COR_001_TM a crm:E42_Identifier ;
    rdfs:label "172523" ;
    crm:P2_has_type "TM" .

data:inscription_I_COR_001 a ogham:Inscription,
        crmtex:TX1_Written_Text ;
    rdfs:label ".. ? ..TETA" ;
    crm:P67_refers_to data:person_I_COR_001_OGALA,
