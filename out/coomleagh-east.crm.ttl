data:match_agent_MAC1945 a rdf:Statement ;
    amt:weight 0.75 ;
    ogham:matchConfidence 0.75 ;
    ogham:matchStatus "auto" ;
    ogham:matchTypeCheck "ok" ;
    rdf:object wd:Q983129 ;
    rdf:predicate skos:closeMatch ;
    rdf:subject data:agent_MAC1945 .

data:match_type_Pillar a rdf:Statement ;
    amt:weight 0.25 ;
    ogham:matchConfidence 0.25 ;
    ogham:matchStatus "auto" ;
    ogham:matchTypeCheck "mismatch" ;
    rdf:object wd:Q4817 ;
    rdf:predicate skos:closeMatch ;
    rdf:subject data:type_Pillar .

data:stone_I_COR_001 a ogham:OghamStone,
        crm:E22_Human-Made_Object ;
    rdfs:label "An Com Liath Thoir | Coomleagh East (CIIC 55)" ;
    crm:P128_carries data:inscription_I_COR_001 ;
    crm:P1_is_identified_by data:id_I_COR_001_CIIC,
        data:id_I_COR_001_CISP,
        data:id_I_COR_001_SMR,
        data:id_I_COR_001_TM ;
    crm:P2_has_type data:type_Pillar ;
    crm:P53_has_former_or_current_location data:place_I_COR_001 ;
    crm:P56_bears_feature data:surface_I_COR_001 .

data:agent_OGHAM_NW a prov:Agent ;
    rdfs:label "OG(H)AM edition (NW)" .

data:id_I_COR_001_CIIC a crm:E42_Identifier ;
    rdfs:label "55" ;
    crm:P2_has_type "CIIC" .

data:id_I_COR_001_CISP a crm:E42_Identifier ;
    rdfs:label "COOME/1" ;
