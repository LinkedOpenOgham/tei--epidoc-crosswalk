data:person_I_COR_001_OGALA a crm:E21_Person ;
    rdfs:label "OGALA" .

data:person_I_COR_001_SAINA a crm:E21_Person ;
    rdfs:label "SAINA" .

data:person_I_COR_001_TEMOCA a crm:E21_Person ;
    rdfs:label "TEMOCA" .

data:place_I_COR_001 a crm:E53_Place ;
    rdfs:label "Coomleagh East (An Com Liath Thoir)" ;
    geo:asWKT "POINT(-9.30337 51.72827)"^^geo:wktLiteral .

data:reading_I_COR_001_MAC1945 a ogham:Reading,
        crmtex:TX6_Transcription ;
