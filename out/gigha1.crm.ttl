@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmtex: <http://www.cidoc-crm.org/cidoc-crm/crmtex/> .
@prefix data: <http://data.ogham.link/crm/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:stone_506 a ogham:OghamStone,
        crm:E22_Human-Made_Object ;
    rdfs:label "Gigha 1 (CIIC 506)" ;
    crm:P128_carries data:inscription_506 ;
    crm:P1_is_identified_by data:id_506_CIIC,
        data:id_506_CISP,
        data:id_506_Trove ;
    crm:P2_has_type data:type_Pillar ;
    crm:P45_consists_of data:material_Granite ;
    crm:P53_has_former_or_current_location data:place_506 ;
    crm:P56_bears_feature data:surface_506 .

data:agent_MAC1902 a prov:Agent ;
    rdfs:label "Macalister 1902" .

data:agent_MAC1945 a prov:Agent ;
    rdfs:label "Macalister 1945" .

data:agent_OGHAM_KF a prov:Agent ;
    rdfs:label "OG(H)AM edition (KF)" .

data:agent_RHY1899 a prov:Agent ;
    rdfs:label "Rhys 1899" .

data:agent_RHY1901 a prov:Agent ;
    rdfs:label "Rhys 1901" .

data:id_506_CIIC a crm:E42_Identifier ;
    rdfs:label "506" ;
    crm:P2_has_type "CIIC" .

data:id_506_CISP a crm:E42_Identifier ;
    rdfs:label "GIGHA/1" ;
    crm:P2_has_type "CISP" .

data:id_506_Trove a crm:E42_Identifier ;
    rdfs:label "38529" ;
    crm:P2_has_type "Trove" .

data:inscription_506 a ogham:Inscription,
        crmtex:TX1_Written_Text ;
    rdfs:label "[---]MAQ[---]COGIN[---]" ;
    crmtex:TXP4_has_segment data:reading_506_MAC1902,
        data:reading_506_MAC1945,
        data:reading_506_OGHAM_KF,
        data:reading_506_RHY1899,
        data:reading_506_RHY1901 .

data:material_Granite a crm:E57_Material ;
    rdfs:label "Granite" .

data:place_506 a crm:E53_Place ;
    rdfs:label "Gigha and Cara" ;
    geo:asWKT "POINT(-5.750278 55.669722)"^^geo:wktLiteral .

data:reading_506_MAC1902 a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "VICULA MAQ COMGINI" ;
    prov:wasAttributedTo data:agent_MAC1902 .

data:reading_506_MAC1945 a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "VICULA MAQ CUGINI" ;
    prov:wasAttributedTo data:agent_MAC1945 .

data:reading_506_OGHAM_KF a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "[---]MAQ[---]COGIN[---]" ;
    prov:wasAttributedTo data:agent_OGHAM_KF .

data:reading_506_RHY1899 a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "MAQICAGILEB" ;
    prov:wasAttributedTo data:agent_RHY1899 .

data:reading_506_RHY1901 a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "OGMA MAQI TIGERNI" ;
    prov:wasAttributedTo data:agent_RHY1901 .

data:surface_506 a crm:E25_Human-Made_Feature ;
    rdfs:label "inscribed surface" .

data:type_Pillar a crm:E55_Type ;
    rdfs:label "Pillar" .

