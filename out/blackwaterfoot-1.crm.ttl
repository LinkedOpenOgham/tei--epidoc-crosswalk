@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmtex: <http://www.cidoc-crm.org/extensions/crmtex/> .
@prefix data: <http://data.ogham.link/crm/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:match_material_Sandstone a rdf:Statement ;
    amt:weight 0.95 ;
    ogham:matchConfidence 0.95 ;
    ogham:matchStatus "auto" ;
    ogham:matchTypeCheck "ok" ;
    rdf:object wd:Q13085 ;
    rdf:predicate skos:closeMatch ;
    rdf:subject data:material_Sandstone .

data:stone_S_BUT_001 a ogham:OghamStone,
        crm:E22_Human-Made_Object ;
    rdfs:label "Blackwaterfoot 1 (S-BUT-001)" ;
    ogham:appCount 9 ;
    ogham:carries data:inscription_S_BUT_001 ;
    ogham:choiceCount 1 ;
    ogham:gapCount 3 ;
    ogham:rdgCount 6 ;
    ogham:recordStatus "numbered" ;
    ogham:suppliedCount 0 ;
    ogham:unclearCount 2 ;
    crm:P1_is_identified_by data:id_S_BUT_001_CISP,
        data:id_S_BUT_001_Trove ;
    crm:P2_has_type data:type_Cave_wall ;
    crm:P45_consists_of data:material_Sandstone ;
    crm:P53_has_former_or_current_location data:place_S_BUT_001 ;
    crm:P56_bears_feature data:surface_S_BUT_001 .

data:agent_FIS2001 a prov:Agent ;
    rdfs:label "Fis 2001" .

data:agent_FOR1996 a prov:Agent ;
    rdfs:label "Forsyth 1996" .

data:agent_OGHAM_KF a prov:Agent ;
    rdfs:label "OG(H)AM edition (KF)" .

data:id_S_BUT_001_CISP a crm:E42_Identifier ;
    rdfs:label "BLFOO/3" ;
    crm:P2_has_type "CISP" .

data:id_S_BUT_001_Trove a crm:E42_Identifier ;
    rdfs:label "39229" ;
    crm:P2_has_type "Trove" .

data:inscription_S_BUT_001 a ogham:Inscription,
        crmtex:TX1_Written_Text ;
    rdfs:label "[---]MEQE[---]" ;
    ogham:identifiedAs data:reading_S_BUT_001_EOMEDTE_or_EOMEQE,
        data:reading_S_BUT_001_EVLEMOE_or_ENEMOE,
        data:reading_S_BUT_001_FIS2001,
        data:reading_S_BUT_001_FOR1996,
        data:reading_S_BUT_001_H_i_e_OMEQ_i_e,
        data:reading_S_BUT_001_OGHAM_KF .

data:place_S_BUT_001 a crm:E53_Place ;
    rdfs:label "Kilmory" ;
    geo:asWKT "POINT(-5.353333 55.526111)"^^geo:wktLiteral .

data:reading_S_BUT_001_EOMEDTE_or_EOMEQE a ogham:Reading ;
    rdfs:label "EOMEDTE or EOMEQE" .

data:reading_S_BUT_001_EVLEMOE_or_ENEMOE a ogham:Reading ;
    rdfs:label "EVLEMOE or ENEMOE" .

data:reading_S_BUT_001_FIS2001 a ogham:Reading ;
    rdfs:label "LUEDBH" ;
    prov:wasAttributedTo data:agent_FIS2001 .

data:reading_S_BUT_001_FOR1996 a ogham:Reading ;
    rdfs:label "ADLEUV",
        "BLUEDLA" ;
    prov:wasAttributedTo data:agent_FOR1996 .

data:reading_S_BUT_001_H_i_e_OMEQ_i_e a ogham:Reading ;
    rdfs:label "H(i/e)OMEQ(i/e)[~]" .

data:reading_S_BUT_001_OGHAM_KF a ogham:Reading ;
    rdfs:label "[---]MEQE[---]" ;
    prov:wasAttributedTo data:agent_OGHAM_KF .

data:surface_S_BUT_001 a crm:E25_Human-Made_Feature ;
    rdfs:label "inscribed surface" .

data:type_Cave_wall a crm:E55_Type ;
    rdfs:label "Cave wall" .

data:material_Sandstone a crm:E57_Material ;
    rdfs:label "Sandstone" ;
    skos:closeMatch wd:Q13085 .

