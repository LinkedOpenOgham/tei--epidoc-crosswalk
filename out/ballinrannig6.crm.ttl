@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmtex: <http://www.cidoc-crm.org/cidoc-crm/crmtex/> .
@prefix data: <http://data.ogham.link/crm/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

data:stone_153 a ogham:OghamStone,
        crm:E22_Human-Made_Object ;
    rdfs:label "Baile an Reannaigh | Ballinrannig 6 (CIIC 153)" ;
    crm:P128_carries data:inscription_153 ;
    crm:P1_is_identified_by data:id_153_CIIC,
        data:id_153_CISP,
        data:id_153_SMR,
        data:id_153_TM ;
    crm:P2_has_type data:type_Pillar ;
    crm:P45_consists_of data:material_Sandstone ;
    crm:P53_has_former_or_current_location data:place_153 ;
    crm:P56_bears_feature data:surface_153 .

data:agent_OGHAM_NW a prov:Agent ;
    rdfs:label "OG(H)AM edition (NW)" .

data:id_153_CIIC a crm:E42_Identifier ;
    rdfs:label "153" ;
    crm:P2_has_type "CIIC" .

data:id_153_CISP a crm:E42_Identifier ;
    rdfs:label "BALIG/6" ;
    crm:P2_has_type "CISP" .

data:id_153_SMR a crm:E42_Identifier ;
    rdfs:label "KE042-057011-" ;
    crm:P2_has_type "SMR" .

data:id_153_TM a crm:E42_Identifier ;
    rdfs:label "www.trismegistos.org/text/172983" ;
    crm:P2_has_type "TM" .

data:inscription_153 a ogham:Inscription,
        crmtex:TX1_Written_Text ;
    rdfs:label "CCICAMINIvac. MAQQ[/I] C[A]TTINI" ;
    crmtex:TXP4_has_segment data:reading_153_OGHAM_NW .

data:material_Sandstone a crm:E57_Material ;
    rdfs:label "Sandstone" .

data:place_153 a crm:E53_Place ;
    rdfs:label "Ballinrannig (Baile an Reannaigh)" ;
    geo:asWKT "POINT(-10.3879 52.1788)"^^geo:wktLiteral .

data:reading_153_OGHAM_NW a ogham:Reading,
        crmtex:TX6_Transcription ;
    rdfs:label "CCICAMINIvac. MAQQ[/I] C[A]TTINI" ;
    prov:wasAttributedTo data:agent_OGHAM_NW .

data:surface_153 a crm:E25_Human-Made_Feature ;
    rdfs:label "inscribed surface" .

data:type_Pillar a crm:E55_Type ;
    rdfs:label "Pillar" .

