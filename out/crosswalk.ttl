@prefix amt: <http://academic-meta-tool.xyz/vocab#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmtex: <http://www.cidoc-crm.org/cidoc-crm/crmtex/> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix teiapp: <http://ontology.ogham.link/tei-application/> .

ogham:coordinateSource a owl:AnnotationProperty ;
    rdfs:label "where a supplied findspot coordinate came from" .

ogham:corpusCommit a owl:AnnotationProperty ;
    rdfs:label "upstream OG(H)AM commit the graph was derived from" .

ogham:corpusCommitDate a owl:AnnotationProperty ;
    rdfs:label "date of that upstream commit" .

ogham:corpusEditionCount a owl:AnnotationProperty ;
    rdfs:label "number of editions in that corpus state" .

ogham:geoCertainty a owl:AnnotationProperty ;
    rdfs:label "editorial @cert on the <geo> value" .

ogham:geoStatus a owl:AnnotationProperty ;
    rdfs:label "findspot coordinate status (asserted/qualified/textual_only/missing)" .

ogham:matchConfidence a owl:AnnotationProperty ;
    rdfs:label "Wikidata reconciliation confidence [0,1]" .

ogham:matchSource a owl:AnnotationProperty ;
    rdfs:label "gazetteer the close match points into" .

ogham:matchStatus a owl:AnnotationProperty ;
    rdfs:label "Wikidata reconciliation status (auto/verified)" .

ogham:matchTypeCheck a owl:AnnotationProperty ;
    rdfs:label "Wikidata P31/P279 type check (ok/mismatch/unknown)" .

ogham:nfdiCoreMatch a owl:AnnotationProperty ;
    rdfs:label "aligns with NFDI Core term" ;
    rdfs:comment "Indicative class-level alignment to the NFDI Core Metadata Profile (schema.org / DCAT / DataCite via the N4O OCMDP)." .

ogham:tei-application a owl:Ontology ;
    rdfs:label "TEI/EpiDoc → CIDOC CRM crosswalk ontology (Linked Open Ogham)" .

teiapp:EditionText a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <div type=edition>" ;
    rdfs:subClassOf ogham:Inscription ;
    skos:note "Application class derived from EpiDoc <div type=edition>." .

teiapp:GazetteerRef a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <ref target=logainm|rcahmw|coflein>" ;
    rdfs:subClassOf ogham:Place ;
    skos:note "Application class derived from EpiDoc <ref target=logainm|rcahmw|coflein>." .

teiapp:Idno a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <idno type=CIIC|CISP|TM|SMR|Trove>" ;
    rdfs:subClassOf crm:E42_Identifier ;
    skos:note "Application class derived from EpiDoc <idno type=CIIC|CISP|TM|SMR|Trove>." .

teiapp:Layout a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc inscribed surface / <layout>" ;
    rdfs:subClassOf crm:E25_Human-Made_Feature ;
    skos:note "Application class derived from EpiDoc inscribed surface / <layout>." .

teiapp:Material a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <material>" ;
    rdfs:subClassOf ogham:Material ;
    skos:note "Application class derived from EpiDoc <material>." .

teiapp:ObjectType a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <objectType>" ;
    rdfs:subClassOf crm:E55_Type ;
    skos:note "Application class derived from EpiDoc <objectType>." .

teiapp:OrigDate a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <origDate> (when present)" ;
    rdfs:subClassOf crm:E52_Time-Span ;
    skos:note "Application class derived from EpiDoc <origDate> (when present)." .

teiapp:OrigPlace a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <origPlace> + <geo>" ;
    rdfs:subClassOf ogham:Place ;
    skos:note "Application class derived from EpiDoc <origPlace> + <geo>." .

teiapp:PersName a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <name nymRef> / <persName>" ;
    rdfs:subClassOf ogham:Person ;
    skos:note "Application class derived from EpiDoc <name nymRef> / <persName>." .

teiapp:PlaceName a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <placeName type=townland|parish|county|…>" ;
    rdfs:subClassOf ogham:Place ;
    skos:note "Application class derived from EpiDoc <placeName type=townland|parish|county|…>." .

teiapp:Reading a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <div type=edition> / <rdg>" ;
    rdfs:subClassOf ogham:Reading ;
    skos:note "Application class derived from EpiDoc <div type=edition> / <rdg>." .

teiapp:Support a teiapp:TEIApplicationClass,
        owl:Class ;
    rdfs:label "TEI/EpiDoc <support> (msDesc)" ;
    rdfs:subClassOf ogham:OghamStone ;
    skos:note "Application class derived from EpiDoc <support> (msDesc)." .

skos:closeMatch a amt:Role ;
    rdfs:label "close match (weighted Wikidata anchor)" ;
    rdfs:comment "Used as an AMT role: each reconciliation quadruple carries amt:weight (the match confidence), so links are weighted beliefs, aligned with axis 2." .

ogham:Inscription a owl:Class ;
    rdfs:subClassOf crmtex:TX1_Written_Text .

ogham:Material a owl:Class ;
    rdfs:subClassOf crm:E57_Material .

ogham:OghamStone a owl:Class ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

ogham:Person a owl:Class ;
    rdfs:subClassOf crm:E21_Person .

ogham:Reading a owl:Class ;
    rdfs:subClassOf crmtex:TX6_Transcription .

crm:E21_Person a owl:Class ;
    ogham:nfdiCoreMatch schema1:Person ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E22_Human-Made_Object a owl:Class ;
    ogham:nfdiCoreMatch schema1:CreativeWork ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E25_Human-Made_Feature a owl:Class ;
    ogham:nfdiCoreMatch schema1:Thing ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E42_Identifier a owl:Class ;
    ogham:nfdiCoreMatch schema1:identifier ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E52_Time-Span a owl:Class ;
    ogham:nfdiCoreMatch schema1:Date ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E53_Place a owl:Class ;
    ogham:nfdiCoreMatch schema1:Place ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E55_Type a owl:Class ;
    ogham:nfdiCoreMatch schema1:DefinedTerm ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crm:E57_Material a owl:Class ;
    ogham:nfdiCoreMatch schema1:material ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crmtex:TX1_Written_Text a owl:Class ;
    ogham:nfdiCoreMatch schema1:CreativeWork ;
    rdfs:subClassOf crm:E1_CRM_Entity .

crmtex:TX6_Transcription a owl:Class ;
    ogham:nfdiCoreMatch schema1:CreativeWork ;
    rdfs:subClassOf crm:E1_CRM_Entity .

ogham:Place a owl:Class ;
    rdfs:subClassOf crm:E53_Place .

crm:E1_CRM_Entity a owl:Class ;
    rdfs:subClassOf owl:Thing .

teiapp:TEIApplicationClass a owl:Class ;
    rdfs:label "TEI/EpiDoc application class" .

