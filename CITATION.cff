    affiliation: "LEIZA - Leibniz-Zentrum für Archäologie"
license: MIT
version: "0.2.1"
date-released: "2026-11-01"
repository-code: "https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk"
keywords:
