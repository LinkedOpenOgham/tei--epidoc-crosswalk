@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmtex: <http://www.cidoc-crm.org/cidoc-crm/crmtex/> .
@prefix crmtex1: <http://www.cidoc-crm.org/extensions/crmtex/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix ogham: <http://ontology.ogham.link/> .
@prefix ontology: <http://ontology.ogham.link/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pleiades: <https://pleiades.stoa.org/places/vocab#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sf: <http://www.opengis.net/ont/sf#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://academic-meta-tool.xyz/vocab#Concept> a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "A node which is part of a triple with a vague edge."@en ;
    rdfs:subClassOf rdfs:Class .

<http://academic-meta-tool.xyz/vocab#Role> a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A vague edge which is part of a triple."@en ;
    rdfs:subClassOf rdf:Property .

<http://lod.ogham.link/data/PythonStonesCIIC> a owl:NamedIndividual,
        prov:SoftwareAgent ;
    rdfs:label "Python Create Script for Ogi Ogham Data"@en ;
    dc:identifier "_run_py3.py" ;
    dcterms:creator <http://lod.ogham.link/data/FlorianThiery> ;
    dcterms:license <https://github.com/FellowsFreiesWissen/Ogham/blob/main/LICENSE> ;
    dcterms:source "python"@en ;
    dcterms:type dcmitype:Software ;
    prov:actedOnBehalfOf <http://lod.ogham.link/data/FlorianThiery> .

ogham: a owl:Ontology ;
    rdfs:label "Ogham Ontology"@en ;
    dc:contributor "Florian Thiery" ;
    dc:creator "Florian Thiery" ;
    dc:description "This ontology contains classes to describe data from Linked Ogham Data."@en ;
    dc:publisher "Florian Thiery" ;
    dc:rights "CC BY 4.0" ;
    dc:subject "ogham" ;
    dc:title "Ogham Ontology"@en ;
    owl:versionInfo "1.1.1",
        "21/08/2024" ;
    skos:definition "This ontology contains classes to describe data from Linked Ogham Data."@en .

ogham:CISP a ogham:Repository,
        owl:NamedIndividual ;
    rdfs:label "Celtic Inscribed Stones Project (CISP)"@en .

ogham:FormulaWord a owl:Class ;
    rdfs:label "Formula Word"@en ;
    rdfs:subClassOf ontology:Word .

ogham:Island a owl:Class ;
    rdfs:label "Island"@en ;
    rdfs:subClassOf ogham:GeographicLocation .

ogham:LogainmMatch a owl:ObjectProperty ;
    rdfs:label "Logainm Match"@en ;
    rdfs:domain <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:range <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:subPropertyOf ogham:exactMatch .

ogham:NomenclatureWord a owl:Class ;
    rdfs:label "Nomenclature Word"@en ;
    rdfs:subClassOf ontology:Word .

ogham:OghamAlphabet a crmtex1:TX3_Writing_System,
        owl:NamedIndividual ;
    rdfs:label "Ogham Alphabet"@en ;
    crmtex:TXP7_has_item ogham:OghamChar .

ogham:OghamIn3D a ogham:Repository,
        owl:NamedIndividual ;
    rdfs:label "Ogham in 3D Project"@en .

ogham:OghamName a owl:Class ;
    rdfs:label "Ogham Name"@en ;
    rdfs:subClassOf ontology:Word .

ogham:OghamStone_CIIC a owl:Class ;
    rdfs:label "Ogham Stone Concept (RAS Macalister)"@en ;
    rdfs:subClassOf ogham:OghamStone .

ogham:OghamStone_CISP a owl:Class ;
    rdfs:label "Ogham Stone Concept (CISP Database)"@en ;
    rdfs:subClassOf ogham:OghamStone .

ogham:OghamStone_O3D a owl:Class ;
    rdfs:label "Ogham Stone Concept (Ogham in 3D Project)"@en ;
    rdfs:subClassOf ogham:OghamStone .

ogham:OghamTribe a owl:Class ;
    rdfs:label "Ogham Tribe"@en ;
    rdfs:subClassOf foaf:Group .

ogham:OpenStreetMapMatch a owl:ObjectProperty ;
    rdfs:label "Open Street Map Match"@en ;
    rdfs:domain <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:range <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:subPropertyOf ogham:exactMatch .

ogham:PlaceOfInterest a owl:ObjectProperty ;
    rdfs:label "place of interest (POI)"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "c.f. https://www.ogc.org/standards/geosparql, 1.0, OGC GeoSPARQL - A Geographic Query Language for RDF Data, 11-052r4, Annex B, B.1"@en .

ogham:ResearchSoftwareEngineer a owl:Class ;
    rdfs:label "Research Software Engineer"@en ;
    rdfs:subClassOf foaf:Person .

ogham:Sandstone a owl:Class ;
    rdfs:label "Sandstone"@en ;
    rdfs:subClassOf ogham:Stone_Material .

ogham:SquirrelOgham a ogham:Repository,
        owl:NamedIndividual ;
    rdfs:label "Ogham Squirrel Project"@en .

ogham:Townland a owl:Class ;
    rdfs:label "Townland"@en ;
    rdfs:subClassOf ogham:ElectoralDevision .

ogham:TownlandsIEMatch a owl:ObjectProperty ;
    rdfs:label "townlands.ie Match"@en ;
    rdfs:domain <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:range <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:subPropertyOf ogham:exactMatch .

ogham:alias a owl:AnnotationProperty ;
    rdfs:label "alias"@de,
        "alias"@en .

ogham:brash_1879 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Brash (1879)"@en ;
    rdfs:isDefinedBy "Brash, R. R. (1879) The Ogam Inscribed Monuments of the Gaedhil in the British Isles. London."@en .

ogham:brikil_1993 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Brindley / Kilfeather (1993)"@en ;
    rdfs:isDefinedBy "Brindley, A, Kilfeather, A. (1993), An Archaeological Inventory of County Carlow, Dublin: Stationery Office."@en .

ogham:carries a owl:ObjectProperty ;
    rdfs:label "carries"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ontology:Inscription ;
    rdfs:subPropertyOf crm:P56_bears_feature .

ogham:centroid a owl:ObjectProperty ;
    rdfs:label "has centroid geometry"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasPointGeometry .

ogham:clusteredArea a owl:ObjectProperty ;
    rdfs:label "has clustered area"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasExactGeometry .

ogham:completeness a owl:DatatypeProperty ;
    rdfs:label "completeness"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:context a owl:DatatypeProperty ;
    rdfs:label "context"@en ;
    rdfs:domain ontology:Word ;
    rdfs:range xsd:string .

ogham:coordinateSource a owl:DatatypeProperty ;
    rdfs:label "source of a supplied coordinate" ;
    rdfs:comment "Where a coordinate came from when the edition gives none: a CISP grid reference, a national monuments record, a Wikidata item." ;
    rdfs:domain ogham:Place ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:corpusCommit a owl:DatatypeProperty ;
    rdfs:label "upstream corpus commit" ;
    rdfs:comment "The commit of the EpiDoc corpus a derived graph was built from. The corpus is a living repository, so a graph that does not name its commit cannot be reproduced." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:corpusCommitDate a owl:DatatypeProperty ;
    rdfs:label "date of the upstream commit" ;
    rdfs:comment "Date of the commit named by ogham:corpusCommit." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:corpusEditionCount a owl:DatatypeProperty ;
    rdfs:label "editions in that corpus state" ;
    rdfs:comment "How many EpiDoc editions the corpus held at that commit." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:integer .

ogham:cuppage_1986 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Cuppage (1986)"@en ;
    rdfs:isDefinedBy "Cuppage, J. et al (1986) Archaeological Survey of the Dingle Peninsula. Ballyferrier: Oidrheacht Chorca Dhuibhne."@en .

ogham:currentlocation a owl:DatatypeProperty ;
    rdfs:label "current location"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:currentsetting a owl:DatatypeProperty ;
    rdfs:label "current setting"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:depth a owl:DatatypeProperty ;
    rdfs:label "depth"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:double ;
    rdfs:subPropertyOf owl:topDataProperty .

ogham:discovery_who a owl:DatatypeProperty ;
    rdfs:label "discovery scientist"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:discovery_year a owl:DatatypeProperty ;
    rdfs:label "discovery year"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:equals a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "equals"@en ;
    rdfs:domain crm:E22_Human-Made_Object ;
    rdfs:range crm:E22_Human-Made_Object ;
    owl:equivalentProperty owl:sameAs .

ogham:ferguson_1887 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Ferguson (1887)"@en ;
    rdfs:isDefinedBy "Ferguson, S. (1887) Ogham Inscriptions in Ireland, Wales and Scotland: Edinburgh."@en .

ogham:form a owl:DatatypeProperty ;
    rdfs:label "form"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:isDefinedBy <https://www.ucl.ac.uk/archaeology/cisp/database/manual/node3.html#SECTION00335000000000000000> ;
    rdfs:range xsd:string .

ogham:geoCertainty a owl:DatatypeProperty ;
    rdfs:label "editorial certainty on the coordinate" ;
    rdfs:comment "The value of @cert on the TEI <geo> element, kept verbatim." ;
    rdfs:domain ogham:Place ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:geoStatus a owl:DatatypeProperty ;
    rdfs:label "findspot coordinate status" ;
    rdfs:comment "How the coordinate of a findspot stands in the edition: asserted (a plain pair), qualified (hedged with @cert or a phrase such as “approximate”), textual_only (prose instead of numbers), supplied (empty in the edition and filled from an outside source), or missing." ;
    rdfs:domain ogham:Place ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:geocodedFrom a owl:DatatypeProperty ;
    rdfs:label "how a place was geocoded" ;
    rdfs:comment "Which service or identifier produced a coordinate for a named place: wikidata, wikidata-qid, osm, osm-id, or manual." ;
    rdfs:domain crm:E53_Place ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:h_status a owl:DatatypeProperty ;
    rdfs:label "height status"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:hasAMT a owl:ObjectProperty ;
    rdfs:label "has AMT node"@en ;
    rdfs:domain <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:range <https://www.w3.org/2000/01/rdf-schema#Resource> .

ogham:hasCollection a owl:ObjectProperty ;
    rdfs:label "has collection"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range ogham:OghamStone_Squirrel .

ogham:hasEPSG a owl:ObjectProperty ;
    rdfs:label "has EPSG code"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    skos:definition "a geometry in a EPSG code"@en .

ogham:hasLocation a owl:ObjectProperty ;
    rdfs:label "has location"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range ogham:GeographicLocation .

ogham:hasType a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:domain <https://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:range crm:E55_Type .

ogham:height a owl:DatatypeProperty ;
    rdfs:label "height"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:double .

ogham:identifiedAs a owl:ObjectProperty ;
    rdfs:label "identified as"@en ;
    rdfs:domain ontology:Inscription ;
    rdfs:range ogham:Reading ;
    rdfs:subPropertyOf crmtex1:TXP4_has_segment .

ogham:irishGrid a owl:DatatypeProperty ;
    rdfs:label "irish grid reference"@en ;
    rdfs:domain ogham:GeographicLocation ;
    rdfs:range xsd:string .

ogham:label_barony a owl:DatatypeProperty ;
    rdfs:label "label barony"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf owl:topDataProperty .

ogham:label_country a owl:DatatypeProperty ;
    rdfs:label "label country"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range xsd:string .

ogham:label_county a owl:DatatypeProperty ;
    rdfs:label "label county"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range xsd:string .

ogham:label_province a owl:DatatypeProperty ;
    rdfs:label "label province"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range xsd:string .

ogham:label_townland a owl:DatatypeProperty ;
    rdfs:label "label townland"@en ;
    rdfs:domain ogham:OghamSite ;
    rdfs:range xsd:string .

ogham:label_upper a owl:DatatypeProperty ;
    rdfs:label "label (uppercase)"@en ;
    rdfs:domain ontology:Person ;
    rdfs:range xsd:string .

ogham:language a owl:DatatypeProperty ;
    rdfs:label "language"@en ;
    rdfs:domain ogham:Reading ;
    rdfs:range xsd:string .

ogham:lastRecorded a owl:ObjectProperty ;
    rdfs:label "last recored"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasPointGeometry .

ogham:locatedAt a owl:ObjectProperty ;
    rdfs:label "is located at"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasPointGeometry .

ogham:macalister_1897 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1897)"@en ;
    rdfs:isDefinedBy "Macalister, R. A. S. (1897) Studies in Irish Epigraphy. A Collection of Revised Readings of the Ancient Inscriptions of Ireland, with Introduction and Notes. Part I. London: David Nutt."@en .

ogham:macalister_1902 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1902)"@en ;
    rdfs:isDefinedBy "Macalister, R. A. S. (1902) Studies in Irish Epigraphy. A Collection of Revised Readings of the Ancient Inscriptions of Ireland, with Introduction and Notes. Part II. London: David Nutt."@en .

ogham:macalister_1907 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1907)"@en ;
    rdfs:isDefinedBy "Macalister, R. A. S. (1907) Studies in Irish Epigraphy. A Collection of Revised Readings of the Ancient Inscriptions of Ireland, with Introduction and Notes Part III. London: David Nutt."@en .

ogham:macalister_1909 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1909)"@en ;
    rdfs:isDefinedBy "Macalister, R.A.S. (1909) The Memorial Slabs of Clonmacnois, King's County. Dublin."@en .

ogham:macalister_1945 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1945)"@en ;
    rdfs:isDefinedBy "Macalister, R. A. S. (1945) Corpus Inscriptionum Insularum Celticarum Vol. I. Dublin: Stationery Office."@en .

ogham:macalister_1949 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Macalister (1949)"@en ;
    rdfs:isDefinedBy "Macalister, R. A. S. (1949) Corpus Inscriptionum Insularum Celticarum Vol. II. Dublin: Stationery Office."@en .

ogham:matchConfidence a owl:AnnotationProperty ;
    rdfs:label "reconciliation confidence" ;
    rdfs:comment "Confidence in a reconciliation link, in [0,1]. Carried on the reified statement alongside amt:weight." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:decimal .

ogham:matchMode a owl:DatatypeProperty ;
    rdfs:label "how the word was matched" ;
    rdfs:comment "Whether a word was matched as a whole token (formula words, compound names) or as a substring (name elements). The two carry different confidence and should not be read alike." ;
    rdfs:domain ontology:Word ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:matchSource a owl:AnnotationProperty ;
    rdfs:label "gazetteer a close match points into" ;
    rdfs:comment "Which authority a weighted skos:closeMatch was drawn from, e.g. Logainm or the RCAHMW Historic Place Names of Wales." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:matchStatus a owl:AnnotationProperty ;
    rdfs:label "reconciliation status" ;
    rdfs:comment "Whether a link was found automatically (auto), asserted by the source (source-asserted), or checked by a person (verified)." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:matchTypeCheck a owl:AnnotationProperty ;
    rdfs:label "type check on a Wikidata match" ;
    rdfs:comment "Result of checking a candidate's P31/P279 against what was expected: ok, mismatch, or unknown." ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:matchedVariant a owl:DatatypeProperty ;
    rdfs:label "spelling that matched" ;
    rdfs:comment "The spelling of a formulaic word that was actually found, where the word has several: MAQQI, MAC and MACCI all match MAQI." ;
    rdfs:domain ontology:Word ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range xsd:string .

ogham:mcmanus_1991 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "McManus (1991)"@en ;
    rdfs:isDefinedBy "McManus, D. (1991) A Guide to Ogam Maynooth Monographs 4. Maynooth: An Sagart."@en .

ogham:okasha_forsyth_2001 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Okasha / Forsyth (2001)"@en ;
    rdfs:isDefinedBy "Okasha, E. and Forsyth, K. (2001) Early Christian Inscriptions of Munster. A Corpus of the Inscribed Stones. Cork: Cork University Press."@en .

ogham:origGeom a owl:ObjectProperty ;
    rdfs:label "orig geometry"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasPointGeometry .

ogham:osullivan_1996 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "O'Sullivan (1996)"@en ;
    rdfs:isDefinedBy "O'Sullivan, A., Sheehan, J. (1996) The Iveragh Peninsula. An Archaeological Survey of South Kerry. Cork: Cork University Press."@en .

ogham:petrie_1872 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Petrie (1872)"@en ;
    rdfs:isDefinedBy "Petrie, G. (1872) Christian Inscriptions in the Irish Language, M. Stokes (ed.), Vol. 1. Dublin: Royal Historical and Archaeological Association."@en .

ogham:power_1992 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Power / Byrne / Egan / Lane / Sleeman (1992)"@en ;
    rdfs:isDefinedBy "Power, D, E. Byrne, U. Egan, S. Lane and M.Sleeman (1992) Archaeological Inventory of County Cork Volume 1: West Cork. Dublin: Stationery Office."@en .

ogham:power_1997 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Power / Byrne / Egan / Lane / Sleeman (1997)"@en ;
    rdfs:isDefinedBy "Power, D., E. Byrne, U. Egan, S. Lane and M.Sleeman (1997) Archaeological Inventory of County Cork Volume 3: Mid Cork. Dublin: Stationery Office."@en .

ogham:preservation a owl:DatatypeProperty ;
    rdfs:label "preservation"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:preservation_note a owl:DatatypeProperty ;
    rdfs:label "preservation (note)"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:range xsd:string .

ogham:raftery_1960 a ogham:Book,
        owl:NamedIndividual ;
    rdfs:label "Raftery (1960)"@en ;
    rdfs:isDefinedBy "Raftery, B. (1960) `National Museum of Ireland, Arch. acquisitions 1958' Journal of the Royal Society of Antiquaries of Ireland 90: 1--40."@en .

ogham:reference a owl:DatatypeProperty ;
    rdfs:label "reference work"@en ;
    rdfs:domain ontology:Word ;
    rdfs:range xsd:string .

ogham:referenceList a owl:DatatypeProperty ;
    rdfs:label "reference list"@en ;
    rdfs:comment "example: ['ogham:Y10000007', 'ogham:Y20000125', 'ogham:macalister_1945:104', 'ogham:cisp:COOGH/1']"@en ;
    rdfs:domain ogham:ReferenceChain ;
    rdfs:range xsd:string .

ogham:references a owl:ObjectProperty ;
    rdfs:label "references"@en ;
    rdfs:domain crm:E22_Human-Made_Object ;
    rdfs:range ogham:Book,
        ogham:Repository .

ogham:representativePoint a owl:ObjectProperty ;
    rdfs:label "representative point"@en ;
    rdfs:domain geo:SpatialObject ;
    rdfs:range geo:SpatialObject ;
    rdfs:subPropertyOf ogham:hasPointGeometry .

ogham:scientist a owl:DatatypeProperty ;
    rdfs:label "scientist"@en ;
    rdfs:domain ogham:Reading ;
    rdfs:range xsd:string .

ogham:scientist_year a owl:DatatypeProperty ;
    rdfs:label "scientist year"@en ;
    rdfs:domain ogham:Reading ;
    rdfs:range xsd:string .

ogham:script a owl:DatatypeProperty ;
    rdfs:label "script"@en ;
    rdfs:domain ogham:Reading ;
    rdfs:range xsd:string .

ogham:shows a owl:ObjectProperty ;
    rdfs:label "shows"@en ;
    rdfs:domain ogham:OghamStone ;
    rdfs:isDefinedBy <https://github.com/LinkedOpenOgham/tei--epidoc-crosswalk> ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( ontology:Person ontology:Word ) ] ;
    rdfs:subPropertyOf crm:P138i_has_representation .

